# ============================================
# Environment variables — salin ke .env lalu isi nilai aslinya.
# .env sudah di-gitignore. JANGAN pernah menaruh secret di file ini.
# Referensi lengkap: bagian "Environment Variables Required" di ROADMAP.md
# ============================================

# --- Next.js & App Config ---
NEXT_PUBLIC_APP_URL="https://furnitech.id"
NEXT_PUBLIC_ROOT_DOMAIN="furnitech.id"

# --- Supabase (PostgreSQL + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Database (Drizzle ORM) ---
# Transaction pooler (port 6543) untuk runtime + drizzle-kit migrations
# Transaction pooler (port 6543) → query runtime
DATABASE_URL="postgresql://postgres.your-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"
# Session pooler (port 5432) → WAJIB untuk `drizzle-kit migrate`, karena
# drizzle-kit memakai pg_advisory_lock yang tidak didukung transaction mode.
DIRECT_URL="postgresql://postgres.your-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- Midtrans Payment & IRIS Payout ---
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxx"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxx"
MIDTRANS_IRIS_API_KEY="IRIS-xxx"

# --- Cloudflare for SaaS (custom domain) ---
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ZONE_ID="your-zone-id"

# --- Fonnte WhatsApp API ---
FONNTE_API_TOKEN="your-fonnte-token"

# --- Firebase Push Notification ---
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-key"
FIREBASE_ADMIN_CREDENTIALS="your-firebase-admin-json"
