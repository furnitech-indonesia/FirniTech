# ============================================
# Environment variables — salin ke .env lalu isi nilai aslinya.
# .env sudah di-gitignore. JANGAN pernah menaruh secret di file ini.
# Referensi lengkap: bagian "Environment Variables Required" di ROADMAP.md
# ============================================

# --- Next.js & App Config ---
NEXT_PUBLIC_APP_URL="https://app.vercel.app"
# Root domain milik FurniTech. KOSONGKAN selama domain belum ada — tenant
# routing berbasis host otomatis dimatikan dan digantikan mode path-based
# (/t/<slug>). Isi nama domain (mis. furnitech.id) begitu tersedia.
NEXT_PUBLIC_ROOT_DOMAIN=""

# --- Supabase (PostgreSQL + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Database (Drizzle ORM) ---
# Transaction pooler (port 6543) untuk runtime + drizzle-kit migrations
# Transaction pooler (port 6543) → query runtime
DATABASE_URL="postgresql://postgres.your-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"
# Session pooler (port 5432) → WAJIB untuk `drizzle-kit migrate`, karena
# drizzle-kit memakai pg_advisory_lock yang tidak didukung transaction mode.
DIRECT_URL="postgresql://postgres.your-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- Midtrans Payment & IRIS Payout ---
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY tidak dipakai alur pendaftaran: kita
# mengarahkan pengguna ke halaman Snap milik Midtrans, jadi tidak ada popup
# Snap JS di browser dan tidak perlu kunci publishable. Jangan menambahkannya
# hanya karena ada di PRD — kunci yang tidak terpakai tetap memperluas
# permukaan kebocoran.
MIDTRANS_SERVER_KEY="SB-Mid-server-xxx"
# "true" = sandbox (app.midtrans.com), "false" = produksi (api.midtrans.com).
# Default di src/lib/midtrans/saas.ts adalah sandbox.
MIDTRANS_IS_SANDBOX="true"
MIDTRANS_IRIS_API_KEY="IRIS-xxx"

# --- Cloudflare for SaaS (custom domain) ---
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ZONE_ID="your-zone-id"

# --- TILE PETA ---
# Peta memakai Leaflet + OpenStreetMap. Tile dari tile.openstreetmap.org
# DILARANG untuk penggunaan komersial atau berskala besar oleh kebijakan
# penggunaan OSM, jadi untuk produksi arahkan variabel ini ke penyedia tile
# yang punya perjanjian (MapTiler, Stadia, atau tile sendiri).
# Kosongkan untuk memakai tile OSM — jangan dipakai di produksi.
NEXT_PUBLIC_OSM_TILE_URL=""

# --- WhatsApp ---
# TIDAK memakai API gateway pihak ketiga. Foto progres dikirim manual oleh
# tukang lewat tautan wa.me (lihat src/lib/wa-link.ts), jadi tidak ada
# kredensial yang perlu diisi di sini.

# --- Firebase Push Notification ---
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-key"
FIREBASE_ADMIN_CREDENTIALS="your-firebase-admin-json"
